{
  "livePreview": true,
  "defaultViewMode": "source",
  "newFileLocation": "folder",
  "newFileFolderPath": "content",
  "attachmentFolderPath": "content/images",
  "useMarkdownLinks": true,
  "alwaysUpdateLinks": true,
  "newLinkFormat": "relative",
  "useTab": false,
  "tabSize": 2,
  "readableLineLength": true,
  "strictLineBreaks": false,
  "propertiesInDocument": "visible",
  "showLineNumber": true,
  "spellcheck": true,
  "foldHeading": true,
  "foldIndent": true,
  "showIndentGuide": true,
  "vimMode": false,
  "promptDelete": true,
  "trashOption": "local",
  "userIgnoreFilters": [
    "output/", "output-preview/", "output-sandbox/", "cache/",
    "node_modules/", "venv/", "_site/", "_posts/"
  ]
}
